#!/usr/bin/env python3
# Enforce only your own shortcuts on ~/.config/kglobalshortcutsrc and keep
# everything else as KDE writes it, so KDE's churn never shows up in chezmoi.
#   Your shortcuts: .chezmoitemplates/kde/kglobalshortcutsrc.overrides
#   Update them from the live file: python3 ~/.local/share/chezmoi/.bin/kde-capture
