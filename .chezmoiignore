.config/syncthing
docs

{{- /* The Claude Desktop updater uses Fedora's RPM/DNF package management. */}}
{{- if not (and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora")) }}
.local/bin/update-claude
{{- end }}

{{- /* KDE/Plasma configs only make sense on `personal` (KDE laptop) machines. */}}
{{- $tags := concat (list "default") (dig "tags" list (dig "machines" .chezmoi.hostname dict .)) | uniq }}
{{- if not (has "personal" $tags) }}
.config/kglobalshortcutsrc
.config/kxkbrc
.config/dolphinrc
.config/konsolerc
{{- end }}

{{- /* Speech-to-text (whisrs) belongs only on personal Linux desktops. */}}
{{- if not (and (eq .chezmoi.os "linux") (has "personal" $tags)) }}
.config/whisrs
.config/systemd/user/whisrs.service
.local/bin/whisrs-kbd
.local/share/applications/net.local.whisrs-kbd.desktop
{{- end }}

{{- /* Clean Mic (QCY buds through noise suppression) belongs only on personal Linux desktops. */}}
{{- if not (and (eq .chezmoi.os "linux") (has "personal" $tags)) }}
.config/pipewire/filter-chain.conf.d/clean-mic.conf
{{- end }}

{{- /* The Groq key stays on each machine: keep `chezmoi add` away from it. */}}
.config/whisrs/secrets.env

{{- /* age (the binary, for SSH-key identities) must exist too, else chezmoi's
       built-in age can't decrypt and aborts apply before packages install. */}}
{{- if not (and (stat (printf "%s/.ssh/id_ed25519" .chezmoi.homeDir)) (lookPath "age")) }}
.thunderbird/.chezmoi-tb/user.js
.thunderbird/.chezmoi-tb/virtualFolders.dat
.thunderbird/.chezmoi-tb/mailViews.dat
{{- end }}
