{{ if dig "machines" .chezmoi.hostname "wake_on_lan" false . -}}
#!/usr/bin/env bash
set -euo pipefail

nmcli -g UUID,TYPE connection show | while IFS=: read -r uuid type; do
  [ "$type" = 802-3-ethernet ] || continue
  sudo nmcli connection modify "$uuid" 802-3-ethernet.wake-on-lan magic
done

nmcli -g DEVICE,TYPE,STATE device | while IFS=: read -r dev type state; do
  [ "$type" = ethernet ] && [ "$state" = connected ] || continue
  sudo nmcli device reapply "$dev"
done
{{ end -}}
